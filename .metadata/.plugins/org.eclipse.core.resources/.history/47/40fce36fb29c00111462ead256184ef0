static void my_flush_cb(
    lv_display_t *display,
    const lv_area_t *area,
    uint8_t *px_map)
{
    TM_ILI9341_DrawBuffer(area->x1, area->y1,area->x2,area->y2, (uint16_t *)px_map);

    lv_display_flush_ready(display);
}
static void password_button_event(lv_event_t *e)
{
    lv_obj_t *btnmatrix = lv_event_get_target(e);

    uint32_t id = lv_buttonmatrix_get_selected_button(btnmatrix);

    if (id == LV_BUTTONMATRIX_BUTTON_NONE)
        return;

    const char *txt = lv_buttonmatrix_get_button_text(btnmatrix, id);

    /* Backspace */
    if (strcmp(txt, LV_SYMBOL_BACKSPACE) == 0)
    {
        if (password_index > 0)
        {
            password_index--;
            password[password_index] = '\0';

            lv_label_set_text(password_box, password);
        }

        return;
    }

    /* Enter */
    if (strcmp(txt, LV_SYMBOL_OK) == 0)
    {
        password[password_index] = '\0';

        if (strcmp(password, correct_password) == 0)
        {
            lv_label_set_text(password_box, "OK");

            /* Password correct */
            /* Go to main screen here */
        }
        else
        {
            lv_label_set_text(password_box, "Wrong");

            password_index = 0;
            password[0] = '\0';
        }

        return;
    }

    /* Only accept numbers */
    if (txt[0] >= '0' && txt[0] <= '9')
    {
        if (password_index < 4)
        {
            password[password_index] = txt[0];
            password_index++;

            password[password_index] = '\0';

            /*
             * Show **** instead of actual password
             */
            char display[5] = "";

            for (uint8_t i = 0; i < password_index; i++)
            {
                display[i] = '*';
            }

            display[password_index] = '\0';

            lv_label_set_text(password_box, display);
        }
    }
}

